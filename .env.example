# Copiar a .env en el servidor y rellenar con valores propios.
# Generar cada secreto con: openssl rand -base64 32
# No reutilizar los del entorno local: están en el repositorio y en el historial.

# Contraseña del usuario sa de SQL Server.
# SQL Server la rechaza si no tiene mayúscula, minúscula, número y símbolo,
# y al menos 8 caracteres; el contenedor no arranca y no dice por qué.
DB_PASSWORD=

# Firma de los tokens de sesión. Cambiarla cierra todas las sesiones abiertas.
# También firma los sub-recursos del proxy de video.
JWT_SECRET=

# Bot de Telegram: token de @BotFather y el chat que puede darle órdenes.
# Sin TELEGRAM_CHAT_ID el bot se niega a arrancar, porque quedaría abierto a
# cualquiera que lo encuentre y ejecuta importaciones en el servidor.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# /pide no necesita ninguna clave: el anime sale de AniList y el cine de
# Wikidata, y ninguno pide registro. Esta clave es opcional: con ella el cine
# pasa a salir de TMDB, que da mejores títulos en español. Es gratuita
# (themoviedb.org -> Ajustes -> API).
TMDB_API_KEY=

# Opcional y de pago: la API de Anthropic (console.anthropic.com). /pide no la
# necesita — interpreta con el Ollama del servidor — pero da mejores resultados
# en pedidos raros que ninguna base de datos indexa.
ANTHROPIC_API_KEY=

# Donaciones. Hay dos formas y con una basta; si están las dos, manda el enlace.
#
# RECOMENDADA — enlace de pago creado en el panel de Mercado Pago
# ("Cobrar" -> "Link de pago"). No necesita credenciales, no caduca y sigue
# funcionando aunque este servidor esté caído. El importe lo pone el donante en
# la página de Mercado Pago.
MP_DONATION_LINK=https://link.mercadopago.com.co/noxis

# ALTERNATIVA — Checkout Pro. Solo compensa si el pago tiene que atarse a algo
# de aquí (desbloquear una cuenta, registrar quién pagó); para una donación
# suelta añade un secreto que puede cobrar y varias formas nuevas de fallar.
# Sale de mercadopago.com/developers -> tus integraciones. El de prueba
# (TEST-...) también sirve y devuelve un enlace de sandbox.
MP_ACCESS_TOKEN=

# Lo que sigue es solo para Checkout Pro; con MP_DONATION_LINK no hace falta
# nada de esto, porque el importe y la vuelta los gestiona Mercado Pago.

# Moneda de la cuenta (COP, ARS, MXN, CLP, UYU, PEN, BRL). Si se deja vacía la
# pone Mercado Pago según el país de la cuenta, que suele ser lo correcto.
MP_CURRENCY=

# Importes sugeridos en los botones, separados por coma. Vacío = solo el campo
# libre. Depende de la moneda: 5000 COP y 5000 ARS no se parecen en nada.
MP_DONATION_PRESETS=

# Límites de lo que se acepta como donación. Son un filtro de disparates
# (importes negativos, ceros de más), no una regla de negocio.
MP_MIN_AMOUNT=1000
MP_MAX_AMOUNT=1000000

# Dirección pública del sitio, para que Mercado Pago sepa a dónde devolver al
# donante. Sin esto se deduce de la petición, que detrás del proxy inverso puede
# no ser la de verdad. Con https además se activa el retorno automático.
PUBLIC_BASE_URL=

# Opcionales
DB_NAME=StreamFlix
PORT=3000

# Tope de títulos que /pide puede proponer de una vez.
PEDIDO_MAX_TITULOS=40
