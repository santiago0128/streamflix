# Copiar a .env en el servidor y rellenar con valores propios.
# Generar cada secreto con: openssl rand -base64 32
# No reutilizar los del entorno local: están en el repositorio y en el historial.

# Contraseña del usuario sa de SQL Server.
# SQL Server la rechaza si no tiene mayúscula, minúscula, número y símbolo,
# y al menos 8 caracteres; el contenedor no arranca y no dice por qué.
DB_PASSWORD=

# Firma de los tokens de sesión. Cambiarla cierra todas las sesiones abiertas.
# También firma los sub-recursos del proxy de video.
JWT_SECRET=

# Bot de Telegram: token de @BotFather y el chat que puede darle órdenes.
# Sin TELEGRAM_CHAT_ID el bot se niega a arrancar, porque quedaría abierto a
# cualquiera que lo encuentre y ejecuta importaciones en el servidor.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Clave de la API de Anthropic (console.anthropic.com). Solo la usa /pide, el
# comando que convierte un pedido en tus palabras en una lista de títulos.
# Sin ella el resto del bot funciona igual.
ANTHROPIC_API_KEY=

# Opcionales
DB_NAME=StreamFlix
PORT=3000

# Tope de títulos que /pide puede proponer de una vez.
PEDIDO_MAX_TITULOS=40
